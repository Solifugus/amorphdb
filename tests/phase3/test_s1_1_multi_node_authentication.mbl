    expired_certificate: {
        scenario: "certificate_expired_during_propagation",
        detection_time: 20,        # 20ms to detect expiry
        error_propagation: "immediate_to_all_nodes",
        fallback_mechanism: "revoke_existing_sessions"
    },
    revoked_token: {
        scenario: "token_revoked_mid_session",
        revocation_propagation_time: 60, # 60ms to propagate revocation
        active_session_handling: "graceful_termination",
        cleanup_completion: "all_nodes_synchronized"
    }
}


    agent_admin: {
        agent_id: "admin_001",
        security_level: "administrator",
        authentication_method: "certificate_based",
        node_access: ["ra-do-ki", "fi-ne-so", "lu-ma-te"],
        privileges: "full_cluster_access"
    },
    agent_user: {
        agent_id: "user_001",
        security_level: "standard_user",
        authentication_method: "password_plus_token",
        node_access: ["ra-do-ki", "fi-ne-so"],
        privileges: "read_write_limited_zones"
    },
    agent_readonly: {
        agent_id: "readonly_001",
        security_level: "read_only",
        authentication_method: "token_based",
        node_access: ["fi-ne-so"],
        privileges: "read_only_access"
    },
    agent_service: {
        agent_id: "service_001",
        security_level: "service_account",
        authentication_method: "mutual_tls",
        node_access: ["ra-do-ki", "fi-ne-so", "lu-ma-te"],
        privileges: "inter_node_coordination"
    }
}

# Test identity verification process
test.auth.identity.verification_process = {
    certificate_validation: {
        ca_signature_check: "valid",
        certificate_expiry: "2027-03-10",
        revocation_list_check: "not_revoked",
        validation_time: 15         # 15ms certificate validation
    },
    password_validation: {
        hash_algorithm: "argon2id",
        salt_strength: "256_bit_random",
        hash_verification_time: 25, # 25ms hash verification
        brute_force_protection: "exponential_backoff"
    },
    token_validation: {
        jwt_signature_check: "valid_ecdsa_p256",
        token_expiry: "valid",
        audience_verification: "correct_node",
        validation_time: 8          # 8ms token validation
    }
}

test.auth.identity.end_time = "@2026-03-10 07:15:30"

test.security.authentication.authentication_methods_tested = 4

output("Agent identity establishment and verification completed")

# Test 2: Cross-node authentication propagation

        version: "1.0",
        config: {
            settings: {
                deep: {
                    nested: {
                        value: "performance_test"
                    }
                }
            }
        }
    }
}

test.perf.complex_child = new(test.perf.complex)
test.perf.complex_child.metadata.config.settings.deep.nested.modified = true

# Access deeply nested inherited properties

    burst_read_001: test.performance.burst.write_burst.burst_write_001,
    burst_read_002: test.performance.burst.write_burst.burst_write_002,
    burst_read_003: test.performance.burst.write_burst.burst_write_003,
    burst_read_004: test.performance.burst.write_burst.burst_write_004,
    burst_read_005: test.performance.burst.write_burst.burst_write_005
}


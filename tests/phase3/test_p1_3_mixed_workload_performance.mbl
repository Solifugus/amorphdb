# Test 4: Burst workload pattern
output("=== Test 4: Burst Workload Pattern ===")

test.performance.burst.start_time = "@2026-03-10 05:18:00"

# Initial burst of writes
test.performance.burst.write_burst = {
    burst_write_001: "burst_pattern_write_001",
    burst_write_002: "burst_pattern_write_002",
    burst_write_003: "burst_pattern_write_003",
    burst_write_004: "burst_pattern_write_004",
    burst_write_005: "burst_pattern_write_005"
}

# Followed by read burst

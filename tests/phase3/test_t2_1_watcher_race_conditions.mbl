# Phase 3 Test T2.1: Watcher vs Manual Write Race Conditions
# Testing simultaneous modifications to watched paths

output("=== T2.1: Testing Watcher vs Manual Write Race Conditions ===")

# Setup base data for race condition testing
test.race.shared_data = {
    counter: 0,
    status: "initial",
    last_modified: "setup",
    race_detection: false
}

output("Created shared data for race condition testing")

# Test 1: Basic watcher setup
output("=== Test 1: Basic Watcher Setup ===")

# Create watcher for counter changes
# Note: Actual watcher syntax may vary - this tests the concept
test.race.watcher_counter = 0
test.race.manual_counter = 0

# Simulate watcher behavior through manual operations
test.race.shared_data.counter = 1
test.race.watcher_counter = 1

# Manual modification immediately after
test.race.shared_data.counter = 2
test.race.manual_counter = 1

output("Basic watcher setup and initial race condition created")

# Test 2: Rapid sequential modifications
output("=== Test 2: Rapid Sequential Modifications ===")

# Create data that will be modified rapidly
test.race.rapid.value = 100
test.race.rapid.modification_count = 0

# Simulate rapid modifications (as fast as possible)
test.race.rapid.value = 101
test.race.rapid.modification_count = 1

test.race.rapid.value = 102
test.race.rapid.modification_count = 2

test.race.rapid.value = 103
test.race.rapid.modification_count = 3

test.race.rapid.value = 104
test.race.rapid.modification_count = 4

test.race.rapid.value = 105
test.race.rapid.modification_count = 5

output("Rapid sequential modifications completed")

# Test 3: Nested object race conditions
output("=== Test 3: Nested Object Race Conditions ===")

test.race.nested = {
    level1: {
        level2: {
            level3: {
                value: "original",
                timestamp: "start"
            }
        }
    }
}

# Simulate watcher monitoring nested.level1.level2.level3.value
# While manual writes modify the same path
test.race.nested.level1.level2.level3.value = "watcher_update_1"
test.race.nested.level1.level2.level3.timestamp = "watcher_time_1"

# Manual write to same nested path
test.race.nested.level1.level2.level3.value = "manual_update_1"
test.race.nested.level1.level2.level3.manual_flag = true

# Another rapid sequence
test.race.nested.level1.level2.level3.value = "watcher_update_2"
test.race.nested.level1.level2.level3.value = "manual_update_2"
test.race.nested.level1.level2.level3.value = "watcher_update_3"

output("Nested object race condition testing completed")

# Test 4: Cross-path interference
output("=== Test 4: Cross-path Interference Testing ===")

# Create related paths that might interfere with each other
test.race.path_a.shared_resource = "resource_a"
test.race.path_b.shared_resource = "resource_b"
test.race.path_c.shared_resource = "resource_c"

# Set up cross-path modifications
test.race.path_a.shared_resource = "modified_a_1"
test.race.path_b.shared_resource = "modified_b_1"

test.race.path_a.shared_resource = "modified_a_2"
test.race.path_c.shared_resource = "modified_c_1"

test.race.path_b.shared_resource = "modified_b_2"
test.race.path_a.shared_resource = "modified_a_3"

output("Cross-path interference testing completed")

# Test 5: High-frequency modification burst
output("=== Test 5: High-frequency Modification Burst ===")

test.race.burst.target = 0

# Create burst of modifications
test.race.burst.target = 1
test.race.burst.target = 2
test.race.burst.target = 3
test.race.burst.target = 4
test.race.burst.target = 5
test.race.burst.target = 6
test.race.burst.target = 7
test.race.burst.target = 8
test.race.burst.target = 9
test.race.burst.target = 10
test.race.burst.target = 11
test.race.burst.target = 12
test.race.burst.target = 13
test.race.burst.target = 14
test.race.burst.target = 15

output("High-frequency modification burst completed")

# Test 6: Complex object modification race
output("=== Test 6: Complex Object Modification Race ===")

test.race.complex = {
    metadata: {
        version: 1,
        status: "active"
    },
    data: {
        values: [100, 200, 300],
        computed: 600
    }
}

# Simulate watcher computing derived values while manual writes modify source
test.race.complex.data.computed = 610  # Watcher recalculation
test.race.complex.data.values = [101, 200, 300]  # Manual modification

test.race.complex.data.computed = 601  # Watcher recalculation
test.race.complex.data.values = [101, 201, 300]  # Another manual modification

test.race.complex.metadata.status = "updating"  # Manual status change
test.race.complex.data.computed = 602  # Watcher still computing

test.race.complex.metadata.version = 2  # Manual version bump
test.race.complex.metadata.status = "active"  # Manual status restore

output("Complex object modification race completed")

# Verification: Check final states
output("=== Final State Verification ===")

test.race.shared_data.counter
test.race.rapid.value
test.race.nested.level1.level2.level3.value
test.race.burst.target
test.race.complex.data.computed
test.race.complex.metadata.version

output("T2.1 watcher vs manual write race condition tests completed")
output("Race condition scenarios tested across various data patterns")
# AmorphDB PWA — Reference Login Watcher
#
# Reference implementation shipped with the AmorphDB PWA boilerplate.
# `amorphctl init-pwa` copies this file into new projects (Phase C4 of
# docs/pwa_auth_development_plan.md) and substitutes the placeholder app
# name `myapp` with the project's chosen app name.
#
# Behavior:
#   - Observes the pre-auth devices subtree.
#   - When a browser writes device.login.submitted = true, looks up the
#     credentials at world.apps.myapp.auth.credentials.<username>.
#   - On success: generates a token, installs it under tokens.<token>,
#     and writes { status: "ok", token: token } to device.login.result.
#   - On failure: writes { status: "error", message: ... } to
#     device.login.result.
#
# The Go bridge detects device.login.result and forwards the parsed JSON
# back to the browser (Step A4 of docs/pwa_auth_development_plan.md).
# The browser stores the token in localStorage and presents it on
# subsequent MCP requests via the X-AmorphDB-Token header (Phase B2).
#
# Apps that need OAuth, SAML, SSO, or passwordless authentication replace
# this watcher entirely. The token handoff (writing to tokens.<token>
# with .identity and .device) and the platform's write boundary are
# unchanged — only the credential validation logic differs. See
# docs/pwa_identity_auth_draft.md for OAuth and SSO examples.
#
# Configuration read at runtime:
#   world.apps.myapp.app._token_ttl  — token lifetime in seconds, or 0
#                                      to never expire. Set by the
#                                      boilerplate from the token_ttl
#                                      attribute on the root <section>
#                                      in app.html.

watch my.app.auth.login_handler(world.apps.myapp.devices):
    for device in world.apps.myapp.devices:
        if device.login.submitted = true:
            username = device.login.username
            password = device.login.password

            creds = world.apps.myapp.auth.credentials[username]
            if is_unknown(creds):
                device.login.result = { status: "error",
                                        message: "Unknown user" }
            else:
                if my.computer.crypto.verify_password(password,
                                                     creds.password_hash,
                                                     creds.salt):
                    token = my.computer.crypto.generate_token()
                    ttl = world.apps.myapp.app._token_ttl

                    world.apps.myapp.tokens[token].identity = username
                    world.apps.myapp.tokens[token].device = device
                    if ttl > 0:
                        world.apps.myapp.tokens[token].@ttl = ttl

                    device.login.result = { status: "ok", token: token }
                else:
                    device.login.result = { status: "error",
                                            message: "Invalid password" }

            device.login.submitted = (quietly) false
